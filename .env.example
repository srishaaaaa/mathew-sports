# Copy to `.env` and fill in real values.

# Signs login sessions (random, 32+ characters). Generate one with:
#   node -e "console.log(require(crypto).randomBytes(48).toString(base64url))"
SESSION_SECRET=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Logins (admin + staff for each branch) are accounts in the database —
# manage them in the Admin Panel → Staff & Memberships.
