# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcodes (no IDs). Run `npm run accounts` to write them into the database.
ADMIN_PASSCODE=
